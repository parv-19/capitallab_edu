NODE_ENV=development
PORT=5000

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Transaction pooler URI — Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# API keys — Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # backend only, never expose to frontend

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_second_long_random_secret
FRONTEND_URL=http://localhost:3000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

LLM_PROVIDER=local
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_LLM_MODEL=gpt-4o-mini
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-latest
GROQ_MODEL=llama-3.1-8b-instant

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LARGE_DOCUMENT_EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_MAX_INPUTS_BEFORE_FALLBACK=48
EMBEDDING_BATCH_SIZE=12
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_DIMENSION=1536
PYTHON_INGESTION_ENABLED=true
PYTHON_EXECUTABLE=python
PYTHON_INGESTION_TIMEOUT_MS=300000

VECTOR_INDEX_NAME=document_chunks_vector_index
RAG_TOP_K=8
RAG_RERANK_TOP_K=4
RAG_MIN_SCORE=0.72
DEBUG_RAG=true
GOOGLE_APPS_SCRIPT_LEADS_URL=

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

NODEMAILER_USER=
NODEMAILER_PASS=
ADMIN_EMAIL=admin@capitallabedu.com
