# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────
# Replace <user>, <pass>, <cluster>, <dbname>
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_32_char_random_string_here
JWT_REFRESH_SECRET=change_me_another_32_char_string

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer via Gmail App Password) ────────────
NODEMAILER_USER=your.gmail@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
NODEMAILER_PASS=xxxx_xxxx_xxxx_xxxx
ADMIN_EMAIL=admin@capitallabedu.com

# ─── AI APIs ─────────────────────────────────────────────
# Set ANTHROPIC_API_KEY & OPENAI_API_KEY for production, OR set GROQ_API_KEY for free local testing
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# ─── File Uploads ────────────────────────────────────────
# Relative to /backend — created automatically on first upload
UPLOAD_DIR=uploads
