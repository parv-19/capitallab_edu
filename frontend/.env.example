# ─── API ──────────────────────────────────────────────────
# Development: http://localhost:5000/api
# Production:  https://api.capitallabedu.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ─── Site URL ────────────────────────────────────────────
# Used for OG tags, sitemap, etc.
# Development: http://localhost:3000
# Production:  https://capitallabedu.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Lead form — SMTP + Google Sheet logging ────────────────
# Used by app/api/lead-notify (lp-cfa forms only). Leave blank to disable.
